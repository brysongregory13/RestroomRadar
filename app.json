{
  "expo": {
    "name": "RestroomRadar",
    "slug": "RestroomRadar",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#00897B"
    },
    "ios": {
      "supportsTablet": true,
      "config": {
        "googleMapsApiKey": "AIzaSyBe1gYpo04xF3oUM_wiWOolwy63Vf9LoaQ"
      },
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "RestroomRadar needs your location to show nearby restrooms.",
        "NSCameraUsageDescription": "RestroomRadar needs camera access to upload restroom photos.",
        "NSPhotoLibraryUsageDescription": "RestroomRadar needs photo library access to upload restroom photos."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#00897B"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyBe1gYpo04xF3oUM_wiWOolwy63Vf9LoaQ"
        }
      },
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "CAMERA",
        "READ_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-dev-client",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "RestroomRadar needs your location to show nearby restrooms."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#00897B"
        }
      ]
    ]
  }
}
